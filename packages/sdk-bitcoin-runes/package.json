{
  "name": "@rosen-bridge/sdk-bitcoin-runes",
  "version": "0.0.0",
  "description": "Bitcoin runes chain specific functions of Rosen SDK to interact with and create transactions on Rosen Bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/rosen-sdk.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run clean && npm run build && npm run test -- --run && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@magiceden-oss/runestone-lib": "^1.0.2",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/bitcoin-runes-utxo-selection": "^2.1.0",
    "@rosen-bridge/sdk-abstract": "^0.1.0",
    "@rosen-bridge/sdk-constant": "^0.1.0",
    "@rosen-bridge/sdk-utils": "^0.1.0",
    "@rosen-bridge/tokens": "^6.0.0",
    "bitcoinjs-lib": "^6.1.7"
  },
  "devDependencies": {
    "@rosen-bridge/address-codec": "^1.2.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11.6.2"
  }
}
