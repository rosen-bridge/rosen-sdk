{
  "name": "@rosen-bridge/sdk-ergo",
  "version": "0.0.0",
  "description": "Ergo chain specific functions of Rosen SDK to interact with and create transactions on Rosen Bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/rosen-sdk.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run clean && npm run build && npm run test -- --run && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/ergo-box-selection": "^2.1.1",
    "@rosen-bridge/sdk-abstract": "^0.0.0",
    "@rosen-bridge/sdk-constant": "^0.0.0",
    "@rosen-bridge/tokens": "^5.0.0",
    "ergo-lib-wasm-nodejs": "0.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^3.1.4",
    "tsx": "^4.20.6",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
