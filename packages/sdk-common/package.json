{
  "name": "@rosen-bridge/sdk-common",
  "version": "0.0.0",
  "description": "This project includes common functions that clients require to interact with and create transactions on Rosen Bridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/rosen-sdk.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitest/coverage-istanbul": "^3.1.4",
    "tsx": "^4.19.4",
    "typescript": "^5.3.3",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@rosen-bridge/abstract-logger": "^2.1.0",
    "@rosen-bridge/minimum-fee": "^2.3.0",
    "@rosen-bridge/tokens": "^3.2.0"
  }
}
