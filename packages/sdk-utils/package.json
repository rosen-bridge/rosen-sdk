{
  "name": "@rosen-bridge/sdk-utils",
  "version": "0.1.0",
  "description": "This project includes utils functions that clients or chain sdks require to interact with",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-bridge/rosen-sdk.git"
  },
  "license": "MIT",
  "author": "Rosen Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/sdk-constant": "^0.1.0"
  },
  "devDependencies": {
    "@rosen-bridge/address-codec": "^1.0.1",
    "@vitest/coverage-istanbul": "^3.1.4",
    "tsx": "^4.20.6",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
